def make_series(T, freq, bump=0.0, seed=0, noise=0.02):
    """One-step-ahead forecasting pairs (x_t -> x_{t+1}); no whole-series normalisation."""
    rng = np.random.default_rng(seed)
    t = np.arange(T + 1)
    s = np.sin(freq * t) + 0.3 * np.sin(2.1 * freq * t) + bump * np.tanh(np.sin(freq * t)) ** 3
    s = 0.9 * np.tanh(s + noise * rng.standard_normal(T + 1))
    x = torch.tensor(s[:-1], dtype=torch.float32)[None]
    y = torch.tensor(s[1:], dtype=torch.float32)[None]
    return x, y


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--epochs", type=int, default=60)
    ap.add_argument("--T", type=int, default=200)
    ap.add_argument("--seed", type=int, default=0)
    args = ap.parse_args()
    torch.manual_seed(args.seed)

    regimes = {"A": (0.30, 0.0), "B": (0.55, 0.5)}
    train, val, test = {}, {}, {}
    for name, (f, b) in regimes.items():
        train[name] = make_series(args.T, f, b, seed=0)
        val[name] = make_series(100, f, b, seed=1)
        test[name] = make_series(100, f, b, seed=2)
    shift = make_series(args.T, 0.80, -0.4, seed=3)

    washout = 10
    model = RCSNFv4(window=8, n=64, pool=8, n_sub=1, hidden=32, steps=4)
    trainer = RCSNFTrainer(model, washout=washout, verbose=True)
    trainer.fit(train, val, shift_env=shift, epochs=args.epochs)

    print("test RMSE per environment:", evaluate(trainer.model, test, washout))
    print("subsystems:", trainer.model.K, "| attempts:", trainer.struct_attempts,
          "| frozen:", trainer.structure_frozen, "| rejections:", trainer.rejections)


if __name__ == "__main__":
    main()
