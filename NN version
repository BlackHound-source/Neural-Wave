#!/usr/bin/env python3
"""
rcsnf_v4.py - Trainable R-CSNF implementing Updates 1-9 of the R-CSCNF spec.

Mapping to the spec:
  U1  trainable encoder / wave core / hybrid decoder, BPTT via autograd
  U2  hard admissibility constraints, accept-or-reject updates, protected parameters
  U3  fast (state/parameter) vs slow (structural) learning timescales
  U4  state reconstruction by phase correction, gradient via autograd (adjoint),
      decaying gain eta_t = eta0 / (1 + lam t)  (+ change-driven boost)
  U5  dynamical mismatch M_t (amplitude + wrapped phase difference)
  U6  staged recovery: plateau -> LR decay -> checkpoint restore -> reconstruction
      (progressive window) -> recalibration -> equation discovery
  U7  evidence-driven, incremental equation discovery with an attempt limit
  U8  protected subsystems + jointly trained gate; new subsystem when extensions fail
  U9  minimax (worst-environment) objective with a soft mean penalty

Requires: torch, numpy
"""
from __future__ import annotations

import argparse
import copy
import math

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F

TWO_PI = 2.0 * math.pi


# ----------------------------------------------------------------------------
# Building blocks
# ----------------------------------------------------------------------------

def normalize(psi, phi, eps=1e-8):
    """Joint L2 normalisation of the two complex fields (per batch element)."""
    nrm = torch.sqrt((psi.abs() ** 2).sum(-1, keepdim=True)
                     + (phi.abs() ** 2).sum(-1, keepdim=True) + eps)
    return psi / nrm, phi / nrm


class Encoder(nn.Module):
    """U1: trainable observation -> complex wave injection Z_t = A * exp(i Phi)."""

    def __init__(self, window, n, hidden):
        super().__init__()
        self.n = n
        self.net = nn.Sequential(nn.Linear(window, hidden), nn.Tanh(),
                                 nn.Linear(hidden, 4 * n))

    def forward(self, w):                       # w: (B, window)
        o = self.net(w).view(w.shape[0], 4, self.n)
        psi = torch.polar(F.softplus(o[:, 0]), o[:, 1])
        phi = torch.polar(F.softplus(o[:, 2]), o[:, 3])
        return normalize(psi, phi)


class HybridDecoder(nn.Module):
    """U1: complex-aware feature extraction first, real-valued layers second."""

    def __init__(self, pool, hidden):
        super().__init__()
        self.pool = pool
        self.readout = nn.Sequential(nn.Linear(7 * pool, hidden), nn.Tanh(),
                                     nn.Linear(hidden, 1))

    def forward(self, psi, phi, k):             # psi, phi: (B, n); k: (n,)
        B = psi.shape[0]
        P = lambda v: v.reshape(B, self.pool, -1).mean(-1)
        d = torch.fft.ifft(1j * k * torch.fft.fft(psi))
        flux = torch.imag(torch.conj(psi) * d)
        feats = torch.cat([P(psi.abs() ** 2), P(phi.abs() ** 2),
                           P(psi.real), P(psi.imag),
                           P(phi.real), P(phi.imag), P(flux)], dim=-1)
        return self.readout(feats).squeeze(-1)


class WaveCore(nn.Module):
    """
    One split-step wave subsystem with learnable physical parameters.
      raw_D     -> dispersion D_psi, D_phi = softplus(raw_D)        (>0 by construction)
      V_amp     -> potential amplitudes                              (checked by admissibility)
      raw_g     -> real coupling strength g = tanh(raw_g) in (-1,1)
      raw_alpha -> injection strength a = sigmoid(raw_alpha) in (0,1)
      nonlin_on -> activation a_j(c_j) of a discovered self-phase term (0/1 buffer)
      nonlin_gain -> coefficient of that term (learnable)
    """

    def __init__(self, n, L=TWO_PI, steps=6, t_evolve=1.0):
        super().__init__()
        x = torch.arange(n, dtype=torch.float32) * (L / n)
        self.register_buffer("k", (2 * math.pi * torch.fft.fftfreq(n, d=L / n)).float())
        self.register_buffer("Vpsi_shape", torch.cos(2 * x))
        self.register_buffer("Vphi_shape", torch.sin(3 * x))
        self.register_buffer("nonlin_on", torch.zeros(()))
        self.steps = steps
        self.dt = t_evolve / steps
        self.raw_D = nn.Parameter(torch.tensor([-2.0, -2.0]))
        self.V_amp = nn.Parameter(torch.tensor([0.4, 0.4]))
        self.raw_g = nn.Parameter(torch.tensor(0.0))
        self.raw_alpha = nn.Parameter(torch.tensor(0.0))
        self.nonlin_gain = nn.Parameter(torch.tensor(0.0))

    def _kin(self, u, D):
        return torch.fft.ifft(torch.fft.fft(u) * torch.exp(-0.5j * D * self.k ** 2 * self.dt))

    def inject(self, psi, phi, psi_in, phi_in):
        a = torch.sigmoid(self.raw_alpha)
        return (1 - a) * psi + a * psi_in, (1 - a) * phi + a * phi_in

    def evolve(self, psi, phi):
        D = F.softplus(self.raw_D)
        c, s = torch.cos(torch.tanh(self.raw_g) * self.dt), torch.sin(torch.tanh(self.raw_g) * self.dt)
        for _ in range(self.steps):
            psi = self._kin(psi, D[0])
            phi = self._kin(phi, D[1])
            pot_psi = (self.V_amp[0] * self.Vpsi_shape * self.dt
                       + self.nonlin_on * self.nonlin_gain * psi.abs() ** 2 * self.dt)
            psi = psi * torch.exp(-1j * pot_psi)
            phi = phi * torch.exp(-1j * self.V_amp[1] * self.Vphi_shape * self.dt)
            psi, phi = c * psi - 1j * s * phi, c * phi - 1j * s * psi   # unitary 2x2 mixing
            psi = self._kin(psi, D[0])
            phi = self._kin(phi, D[1])
        return normalize(psi, phi)


class RCSNFv4(nn.Module):
    """Encoder -> K wave subsystems -> hybrid decoders -> (gated) prediction."""

    def __init__(self, window=8, n=64, pool=8, n_sub=1, hidden=32, steps=4):
        super().__init__()
        assert n % pool == 0
        self.window, self.n, self.pool = window, n, pool
        self.hidden, self.steps, self.K = hidden, steps, n_sub
        self.encoder = Encoder(window, n, hidden)
        self.cores = nn.ModuleList([WaveCore(n, steps=steps) for _ in range(n_sub)])
        self.decoders = nn.ModuleList([HybridDecoder(pool, hidden) for _ in range(n_sub)])
        self.gate = nn.Linear(window + n_sub * pool, n_sub)

    def init_state(self, B, device=None):
        psi = (torch.ones(self.K, B, self.n, dtype=torch.cfloat, device=device)
               / math.sqrt(self.n))
        return psi, torch.zeros_like(psi)

    def forward(self, x, state=None):
        """x: (B, T) inputs. Returns predictions (B, T) and final state."""
        B, T = x.shape
        pad = torch.cat([x[:, :1].expand(B, self.window - 1), x], dim=1)
        W = pad.unfold(1, self.window, 1)                      # (B, T, window)
        psi, phi = state if state is not None else self.init_state(B, x.device)
        preds = []
        for t in range(T):
            w = W[:, t]
            p_in, f_in = self.encoder(w)
            ps, fs = [], []
            for k, core in enumerate(self.cores):
                a, b = core.inject(psi[k], phi[k], p_in, f_in)
                a, b = core.evolve(a, b)
                ps.append(a)
                fs.append(b)
            psi, phi = torch.stack(ps), torch.stack(fs)
            yk = torch.stack([self.decoders[k](psi[k], phi[k], self.cores[k].k)
                              for k in range(self.K)], dim=1)   # (B, K)
            if self.K > 1:
                pooled = torch.cat([(psi[k].abs() ** 2).reshape(B, self.pool, -1).mean(-1)
                                    for k in range(self.K)], dim=-1)
                pi = torch.softmax(self.gate(torch.cat([w, pooled], -1)), dim=-1)
                preds.append((pi * yk).sum(-1))
            else:
                preds.append(yk[:, 0])
        return torch.stack(preds, dim=1), (psi, phi)

    def add_subsystem(self):
        """U8: append a new wave subsystem; old subsystems are untouched."""
        K, dev = self.K, next(self.parameters()).device
        new_gate = nn.Linear(self.window + (K + 1) * self.pool, K + 1).to(dev)
        with torch.no_grad():
            new_gate.weight.mul_(0.01)
            new_gate.bias.zero_()
            new_gate.weight[:K, :self.window + K * self.pool] = self.gate.weight
            new_gate.bias[:K] = self.gate.bias
        self.gate = new_gate
        self.cores.append(WaveCore(self.n, steps=self.steps).to(dev))
        self.decoders.append(HybridDecoder(self.pool, self.hidden).to(dev))
        self.K = K + 1


# ----------------------------------------------------------------------------
# U4/U5: reconstruction and dynamical mismatch
# ----------------------------------------------------------------------------

def mismatch(psi_pred, psi_rec, a=1.0, b=1.0, eps=1e-3):
    """U5: amplitude mismatch + wrapped phase mismatch. angle(p * conj(r)) is wrapped to (-pi, pi]."""
    amp = (psi_pred.abs() - psi_rec.abs()) ** 2
    dphi = torch.angle(psi_pred * torch.conj(psi_rec))
    mask = ((psi_pred.abs() * psi_rec.abs()) > eps).float()
    return (a * amp + b * mask * dphi ** 2).mean()


def reconstruct_state(model, x, y, state0, washout, steps, eta0, lam, mu, eta_max, boost=0.0):
    """
    U4: reverse-time correction by phase adjustment.
    Gradient of the observation loss w.r.t. the phase field is obtained by autograd
    (the adjoint), so the residual->phase map R_Phi is defined by the decoder and
    the wave dynamics. Gain eta_t = eta0/(1+lam t) + boost, clipped to eta_max.
    """
    psi0, phi0 = state0
    delta = torch.zeros(model.n, requires_grad=True)
    for t in range(steps):
        eta = min(eta0 / (1.0 + lam * t) + boost, eta_max)
        pred, _ = model(x, state=(psi0 * torch.exp(1j * delta), phi0))
        loss = F.mse_loss(pred[:, washout:], y[:, washout:]) + mu * (delta ** 2).mean()
        g, = torch.autograd.grad(loss, delta)
        with torch.no_grad():
            delta -= eta * g
    with torch.no_grad():
        return (psi0 * torch.exp(1j * delta), phi0)


# ----------------------------------------------------------------------------
# U2 / U9: admissibility, objective, accept-or-reject step
# ----------------------------------------------------------------------------

def admissible(model, prot, D_range=(1e-4, 5.0), V_max=2.0):
    for name, p in model.named_parameters():
        if not torch.isfinite(p).all():
            return False, f"non-finite parameter {name}"
    for c in model.cores:
        D = F.softplus(c.raw_D)
        if bool(((D < D_range[0]) | (D > D_range[1])).any()):
            return False, "dispersion out of admissible range"
        if float(c.V_amp.abs().max()) > V_max:
            return False, "potential out of admissible range"
    named = dict(model.named_parameters())
    for name, val in prot.items():
        if not torch.equal(named[name].detach(), val):
            return False, f"protected parameter changed: {name}"
    return True, "ok"


def objective(model, envs, washout, soft_w=0.1):
    """U9: worst-environment (minimax) loss plus a soft mean penalty (U2 soft term)."""
    losses = []
    for x, y in envs.values():
        pred, _ = model(x)
        losses.append(F.mse_loss(pred[:, washout:], y[:, washout:]))
    L = torch.stack(losses)
    return L.max() + soft_w * L.mean(), L


def constrained_step(model, opt, envs, washout, prot, clip=1.0):
    """U2: propose an update; keep it only if all mandatory constraints pass."""
    ckpt = (copy.deepcopy(model.state_dict()), copy.deepcopy(opt.state_dict()))
    opt.zero_grad(set_to_none=True)
    loss, _ = objective(model, envs, washout)
    if not torch.isfinite(loss):
        return False, "non-finite loss"
    loss.backward()
    torch.nn.utils.clip_grad_norm_(model.parameters(), clip)
    opt.step()
    ok, why = admissible(model, prot)
    if not ok:
        model.load_state_dict(ckpt[0])
        opt.load_state_dict(ckpt[1])
        return False, why
    return True, "accepted"


def adapt(model, envs, steps, lr, washout, prot):
    m = copy.deepcopy(model)
    opt = torch.optim.Adam([p for p in m.parameters() if p.requires_grad], lr=lr)
    ok = True
    for _ in range(steps):
        ok_s, _ = constrained_step(m, opt, envs, washout, prot)
        ok = ok and ok_s
    return m, ok


def protect(model, prefixes):
    """U8/U2: freeze parameters whose names start with a prefix; return immutable snapshot."""
    snap = {}
    for name, p in model.named_parameters():
        if any(name.startswith(pre) for pre in prefixes):
            p.requires_grad_(False)
            snap[name] = p.detach().clone()
    return snap


@torch.no_grad()
def eval_worst(model, envs, washout):
    _, L = objective(model, envs, washout)
    return float(L.max())


@torch.no_grad()
def worst_env(model, envs, washout):
    best, best_l = None, -1.0
    for x, y in envs.values():
        pred, _ = model(x)
        l = float(F.mse_loss(pred[:, washout:], y[:, washout:]))
        if l > best_l:
            best, best_l = (x, y), l
    return best


@torch.no_grad()
def evaluate(model, envs, washout):
    out = {}
    for name, (x, y) in envs.items():
        pred, _ = model(x)
        out[name] = float(torch.sqrt(F.mse_loss(pred[:, washout:], y[:, washout:])))
    return out


# ----------------------------------------------------------------------------
# U6: plateau detection
# ----------------------------------------------------------------------------

class PlateauDetector:
    """Plateau = improvement across blocks is not larger than the block-mean noise."""

    def __init__(self, window=15, blocks=3, z=1.0):
        self.W, self.B, self.z = window, blocks, z
        self.h = []

    def add(self, v):
        self.h.append(float(v))

    def plateaued(self):
        n = self.W * self.B
        if len(self.h) < n:
            return False
        r = np.asarray(self.h[-n:])
        means = r.reshape(self.B, self.W).mean(axis=1)
        improvement = means[0] - means[-1]
        noise = np.std(r, ddof=1) / math.sqrt(self.W)
        return improvement < self.z * noise

    def reset(self):
        self.h = []


# ----------------------------------------------------------------------------
# U7: equation-extension library
# ----------------------------------------------------------------------------

def _enable_nonlinear_selfphase(m):
    m.cores[0].nonlin_on.fill_(1.0)


EXTENSIONS = {"nonlinear_selfphase": _enable_nonlinear_selfphase}


# ----------------------------------------------------------------------------
# Trainer: staged recovery + evidence-driven discovery
# ----------------------------------------------------------------------------

class RCSNFTrainer:
    def __init__(self, model, lr=3e-3, min_lr=1e-5, washout=10,
                 plateau_window=15, plateau_blocks=3, plateau_z=1.0,
                 evidence_threshold=3.0, max_struct_attempts=2, max_subsystems=3,
                 recon_min_len=40, recon_steps=40, recal_steps=20,
                 eta0=0.2, lam=0.05, kappa=0.5, eta_max=0.5, mu=1e-3,
                 mm_thr=1e-2, recon_tol=None, margin=0.02, verbose=True):
        self.model = model
        self.lr0 = self.lr = lr
        self.min_lr, self.washout = min_lr, washout
        self.plateau = PlateauDetector(plateau_window, plateau_blocks, plateau_z)
        self.evidence, self.evidence_threshold = 0.0, evidence_threshold
        self.max_struct, self.struct_attempts = max_struct_attempts, 0
        self.max_subsystems, self.structure_frozen = max_subsystems, False
        self.recon_min_len, self.recon_steps, self.recal_steps = recon_min_len, recon_steps, recal_steps
        self.eta0, self.lam, self.kappa, self.eta_max, self.mu = eta0, lam, kappa, eta_max, mu
        self.mm_thr, self.recon_tol, self.margin = mm_thr, recon_tol, margin
        self.boost = 0.0
        self.prot = {}
        self.opt = self._make_opt()
        self.best, self.best_val = None, float("inf")
        self.rejections = 0
        self.shift_env = None
        self.verbose, self.log = verbose, []

    # -- helpers -----------------------------------------------------------
    def _say(self, msg):
        self.log.append(msg)
        if self.verbose:
            print(msg)

    def _make_opt(self):
        return torch.optim.Adam([p for p in self.model.parameters() if p.requires_grad], lr=self.lr)

    def _set_lr(self, lr):
        self.lr = lr
        for g in self.opt.param_groups:
            g["lr"] = lr

    def _checkpoint(self):
        return copy.deepcopy(self.model.state_dict()), copy.deepcopy(self.opt.state_dict())

    def _restore(self, ckpt):
        self.model.load_state_dict(ckpt[0])
        self.opt.load_state_dict(ckpt[1])
        self._set_lr(self.lr)

    def _protect_prefixes(self, prefixes):
        self.prot.update(protect(self.model, prefixes))
        self.opt = self._make_opt()

    def _score(self, model, train_envs, val_envs):
        """Held-out worst error after adaptation, plus shift-recovery error (U7 candidate criteria)."""
        m, ok = adapt(model, train_envs, self.recal_steps, self.lr0 * 0.5, self.washout, self.prot)
        s = eval_worst(m, val_envs, self.washout)
        if self.shift_env is not None:
            m2, ok2 = adapt(m, {"shift": self.shift_env}, self.recal_steps, self.lr0 * 0.5,
                            self.washout, self.prot)
            ok = ok and ok2
            s += eval_worst(m2, {"shift": self.shift_env}, self.washout)
        return ok and bool(np.isfinite(s)), s, m

    # -- U8: new subsystem -------------------------------------------------
    def _add_subsystem(self):
        old_K = self.model.K
        self.model.add_subsystem()
        self._protect_prefixes([f"cores.{k}." for k in range(old_K)]
                               + [f"decoders.{k}." for k in range(old_K)])
        self.best, self.best_val = None, float("inf")   # architecture changed
        self._say(f"added protected subsystem #{old_K}; subsystems now {self.model.K}")

    # -- U7: evidence-driven discovery --------------------------------------
    def _discover(self, train_envs, val_envs):
        self.struct_attempts += 1
        ok0, base, _ = self._score(self.model, train_envs, val_envs)
        best_s, best_m = float("inf"), None
        for name, apply in EXTENSIONS.items():
            cand = copy.deepcopy(self.model)
            apply(cand)
            ok, s, m = self._score(cand, train_envs, val_envs)
            if ok and s < best_s:
                best_s, best_m = s, m
            self._say(f"  candidate '{name}': ok={ok} score={s:.4f} (base {base:.4f})")
        if best_m is not None and best_s < base * (1 - self.margin):
            self.model.load_state_dict(best_m.state_dict())
            self.evidence, self.best, self.best_val = 0.0, None, float("inf")
            self._say("accepted equation extension")
        else:
            self.evidence += 1.0
            self._say("no admissible extension improved the system; adding subsystem")
            if self.model.K < self.max_subsystems:
                self._add_subsystem()
        if self.struct_attempts >= self.max_struct:
            self.structure_frozen = True
            self._say("structural search frozen (attempt limit reached)")

    # -- U4/U5/U6: reconstruction ------------------------------------------
    def _reconstruct_and_check(self, x, y, tol):
        state0 = tuple(s.detach() for s in self.model.init_state(1, x.device))
        T, seg, mm = x.shape[1], self.recon_min_len, 0.0
        while True:
            seg = min(seg, T)
            xs, ys = x[:, -seg:], y[:, -seg:]
            wash = min(self.washout, seg // 4)
            rec = reconstruct_state(self.model, xs, ys, state0, wash, self.recon_steps,
                                    self.eta0, self.lam, self.mu, self.eta_max, self.boost)
            with torch.no_grad():
                pred, _ = self.model(xs, state=rec)
                _, st0 = self.model(xs, state=state0)
                err = float(F.mse_loss(pred[:, wash:], ys[:, wash:]))
                mm = float(mismatch(rec[0], st0[0]))
            if err <= tol:
                return True, mm
            if seg >= T:
                return False, mm
            seg *= 2                                   # progressively expand window

    def _recover(self, train_envs, val_envs):
        # Stage 3: restore best admissible checkpoint
        if self.best is not None:
            self._restore(self.best)
        # Stage 4: reconstruct state for the worst environment
        x, y = worst_env(self.model, val_envs, self.washout)
        tol = self.recon_tol or 2.0 * max(self.best_val, 1e-4)
        ok, mm = self._reconstruct_and_check(x, y, tol)
        # U5 / U4: change-driven boost to the correction gain
        self.boost = self.kappa * min(1.0, mm / self.mm_thr) if mm > self.mm_thr else 0.0
        self.evidence = max(0.0, self.evidence - 1.0) if ok else self.evidence + 1.0
        self._say(f"reconstruction {'ok' if ok else 'failed'} (mismatch={mm:.3e})")
        # Stage 5: recalibrate existing parameters, structure fixed
        before = self.best_val
        self._set_lr(self.lr0 * 0.5)
        for _ in range(self.recal_steps):
            constrained_step(self.model, self.opt, train_envs, self.washout, self.prot)
        now = eval_worst(self.model, val_envs, self.washout)
        if now < before:
            self.best, self.best_val = self._checkpoint(), now
        else:
            self.evidence += 1.0
        self._set_lr(self.lr0 * 0.5)
        self.plateau.reset()
        # Stage 6: discovery when evidence crosses threshold
        if self.evidence >= self.evidence_threshold and not self.structure_frozen:
            self._discover(train_envs, val_envs)

    # -- main loop ----------------------------------------------------------
    def fit(self, train_envs, val_envs, shift_env=None, epochs=100):
        self.shift_env = shift_env
        for ep in range(epochs):
            ok, why = constrained_step(self.model, self.opt, train_envs, self.washout, self.prot)
            if not ok:
                self.rejections += 1
            val = eval_worst(self.model, val_envs, self.washout)
            if ok and np.isfinite(val) and val < self.best_val:
                self.best, self.best_val = self._checkpoint(), val
            self.plateau.add(val)
            if self.plateau.plateaued():               # Stage 1 + 2
                self.evidence += 1.0
                self._set_lr(self.lr * 0.5)
                self._say(f"[ep {ep}] plateau -> lr {self.lr:.2e}")
                if self.lr < self.min_lr:
                    self._recover(train_envs, val_envs)
                self.plateau.reset()
            if ep % 10 == 0:
                self._say(f"[ep {ep}] val_worst={val:.4f} rejected={self.rejections} "
                          f"K={self.model.K} evidence={self.evidence:.1f}")
        return self


